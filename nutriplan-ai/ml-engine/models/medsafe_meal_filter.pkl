# ============ PATH CONFIG =============
BASE_DIR = Path(__file__).resolve().parent.parent
DATA_PATH = BASE_DIR / "data" / "processed" / "meal_safety.csv"
MODEL_PATH = BASE_DIR / "models" / "medsafe_meal_filter.pkl"
META_PATH = BASE_DIR / "models" / "medsafe_meal_filter_metadata.json"
WORD2VEC_PATH = BASE_DIR / "models" / "medsafe_word2vec.model"

